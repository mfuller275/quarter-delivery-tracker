# Copy this file to ".env" and adjust the values for your organization.

# --- Azure DevOps ---
ADO_ORG=hexagonPPMCOL
ADO_PROJECT=PPM
API_VERSION=7.0
# Optional: GUID of a SAVED Azure DevOps query. If set, the app runs this query
# instead of the built-in default WIQL. The query URL you shared uses a
# "tempQueryId" which is temporary, so open the query in ADO, click Save, then
# copy the GUID that appears in the URL (…/_queries/query/<GUID>) and paste here.
QUERY_ID=

# --- Field mapping ---
# The field that identifies a "team". You said you use a custom Team field.
# Use /api/fields (see README) to discover the exact referenceName, then set it
# here. Examples: System.AreaPath  or  Custom.Team
TEAM_FIELD=System.AreaPath

POINTS_FIELD=Microsoft.VSTS.Scheduling.StoryPoints
EFFORT_FIELD=Microsoft.VSTS.Scheduling.Effort
TARGET_DATE_FIELD=Microsoft.VSTS.Scheduling.TargetDate

# Feature-level release/quarter tracking. The Release field value should contain
# the quarter and year (e.g. "… Q3 2026 …"); the app parses Q# and the year.
RELEASE_FIELD=Custom.Release
FEATURE_TYPE=Feature

# States that count as "delivered/complete" (comma separated).
COMPLETED_STATES=Closed,Done,Completed,Resolved,Ready to Release,Released

# States that are cancelled/dropped and should be excluded from totals.
EXCLUDED_STATES=Removed,Cut

# Tags that flag an item as blocked/at-risk (comma separated, case-insensitive).
BLOCKED_TAGS=Blocked,At Risk,Impediment

# --- Quarter window ---
# Leave blank to auto-detect the current calendar quarter, or override with
# explicit ISO dates (YYYY-MM-DD).
QUARTER_START=
QUARTER_END=

# --- Authentication ---
# "interactive" (default): one shared identity via a browser popup on the server.
#   Simple locally, but the localhost redirect is flaky on some servers/RDP.
# "devicecode": one shared identity via the device-code flow. Open a URL and type
#   a code (microsoft.com/devicelogin) - robust on headless/RDP servers. Do a
#   one-time sign-in with signin.py, then the server refreshes silently.
# "oauth": each user signs in with their OWN Microsoft account/MFA (per-user).
#   Requires an Entra ID app registration and the ENTRA_* values below + HTTPS.
AUTH_MODE=interactive

# Entra ID app registration (only needed when AUTH_MODE=oauth):
#   1. Entra admin center > App registrations > New registration (Web platform).
#   2. Add Redirect URI = the OAUTH_REDIRECT_URI value below (Web type).
#   3. API permissions > Add > Azure DevOps > Delegated > user_impersonation > grant.
#   4. Certificates & secrets > New client secret > copy the VALUE.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Must EXACTLY match a redirect URI on the app registration. Use the real
# host/scheme users hit (https strongly recommended in production).
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
# Long random string used to sign the session cookie. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
